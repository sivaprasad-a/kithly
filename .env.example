# Copy to .env.local and fill in what you need. Everything here is optional
# for a first run except BETTER_AUTH_SECRET.

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Kithly          # change once you pick the final name
NEXT_PUBLIC_AI_NAME=Kiki             # your AI co-host's name

# ── Auth (Better Auth) ────────────────────────────────────────────────
# Generate one: npx @better-auth/cli secret   (or any 32+ random characters)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Social sign-in (free). Leave blank to use email + password only.
# Google:   https://console.cloud.google.com/apis/credentials
#           Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps
#           Redirect URI: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Database ──────────────────────────────────────────────────────────
# Blank = in-memory store (data resets when the dev server restarts).
# Local Docker:   mongodb://localhost:27017      (npm run db:up)
# Atlas free M0:  mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net
MONGODB_URI=
MONGODB_DB=kithly

# ── AI co-host (optional) ─────────────────────────────────────────────
# Without a key, the "Write it with Kiki" button uses built-in templates.
# Free tier: Google Gemini key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Or Claude (paid, pay-as-you-go): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override, e.g. gemini-flash-latest or claude-haiku-5-5
AI_MODEL=
